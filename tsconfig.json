{
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "engine/**/*.ts",
    "instances/**/*.ts",
    "supabase/functions/**/*.ts",
    "supabase/tests/**/*.ts"
  ],
  "exclude": ["engine/ui/**", "instances/*/ui/**", "instances/*/cards/**/paint.ts", "instances/*/cards/**/lines.ts"]
}
