{
  "name": "dividedworld",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs --check",
    "build:ci": "node tools/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "test:engine": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"engine/**/*.test.ts\" \"instances/**/*.test.ts\" \"supabase/functions/**/*.test.ts\"",
    "test:sql": "node tools/test-sql.mjs",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "test:ui": "vitest run",
    "storybook": "storybook dev -p 6006",
    "test:e2e": "node tools/test-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
